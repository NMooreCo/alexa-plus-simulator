{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["src/cli.ts", "src/proxy", "src/check", "src/model", "src/link", "src/visual", "src/report", "src/shared", "test", "vitest.config.ts", "vite.config.ts", "vite.server.config.ts"]
}
