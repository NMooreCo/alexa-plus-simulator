{
  "name": "alexa-plus-simulator",
  "version": "0.1.0",
  "description": "An open, unofficial simulator and readiness check for Alexa+ MCP add-ons: point it at your MCP server, talk to it on a simulated Echo Show or Echo Dot, see your MCP Apps screens, and check it against Amazon's published requirements.",
  "license": "MIT",
  "author": "Nick Moore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NMooreCo/alexa-plus-simulator.git"
  },
  "homepage": "https://github.com/NMooreCo/alexa-plus-simulator#readme",
  "bugs": {
    "url": "https://github.com/NMooreCo/alexa-plus-simulator/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "alexa-plus-simulator": "dist/server/cli.js"
  },
  "exports": {
    "./ui": {
      "types": "./dist/lib/types/ui/simulator.d.ts",
      "default": "./dist/lib/simulator.js"
    },
    "./ui/style.css": {
      "types": "./dist/lib/style.css.d.ts",
      "default": "./dist/lib/style.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "keywords": [
    "alexa",
    "alexa+",
    "mcp",
    "model-context-protocol",
    "mcp-apps",
    "simulator",
    "echo-show"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.server.config.ts && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "start": "node dist/server/cli.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "check": "pnpm build && pnpm typecheck && vitest run",
    "example": "node examples/tasks/server.mjs",
    "notices": "node scripts/notices.mjs",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "@anthropic-ai/foundry-sdk": "0.6.0",
    "@anthropic-ai/sdk": "^0.135.0",
    "aws4fetch": "1.0.20",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
